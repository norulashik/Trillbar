# ── Required ──────────────────────────────────────────────────────────────────

# Google Gemini — used for translation, emotion analysis, script alignment
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ElevenLabs — voice cloning, TTS, audio isolation, speech-to-speech
# Creator plan ($22/mo) or above required for voice cloning.
# Free tier supports TTS with fallback voices only.
ELEVENLABS_API_KEY=

# AssemblyAI — transcription + speaker diarization
# Sign up at: https://www.assemblyai.com
# Free tier: 100 minutes/month
ASSEMBLYAI_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────

# Sarvam AI — alternative TTS optimised for Indian languages (Hindi/Tamil/Telugu)
# If set, use TTS_BACKEND=sarvam to route TTS through Sarvam instead of ElevenLabs
SARVAM_API_KEY=

# TTS backend: "elevenlabs" (default) or "sarvam"
TTS_BACKEND=elevenlabs

# Toggle emotion analysis (uses Gemini)
ENABLE_EMOTION=true

# ── AI Lip Sync (SyncLabs) ────────────────────────────────────────────────────
# Optional — enables the "Sync AI" button for AI-driven lip sync correction.
# Sign up at: https://sync.so — Creator plan ($19/mo) supports up to 5-min videos.
SYNCLABS_API_KEY=

# Publicly reachable URL of this backend — SyncLabs fetches video/audio from this URL.
# For local dev: run `ngrok http 8000` and paste the https URL here (no trailing slash).
# Example: https://abc123.ngrok-free.app
SYNCLABS_PUBLIC_BASE_URL=

# ── Required ──────────────────────────────────────────────────────────────────
# Gemini API key — used for translation (replaces OpenAI GPT-4o)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyBRuF2Skar8x1G2L7BsfRplujOc2GMA8Sk

# ElevenLabs (voice cloning + multilingual TTS)
# Free tier does NOT support voice cloning — Creator plan ($22/mo) or above required.
# If unavailable, set ELEVENLABS_API_KEY= and the system falls back to default voices.
ELEVENLABS_API_KEY=sk_6c0a2e92bb542496fe95085a5c065e76e497c6fabffd6fff

# HuggingFace token — needed for pyannote speaker diarization m
# Accept model license at: https://huggingface.co/pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=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

# ── Optional ──────────────────────────────────────────────────────────────────
# Sarvam AI (Indian-language-optimised TTS, alternative to ElevenLabs)
SARVAM_API_KEY=

# Whisper model size (tiny / base / small / medium)
# Larger = more accurate but slower on CPU.  "base" is the recommended default.
WHISPER_MODEL=base

# Demucs model name (htdemucs / htdemucs_ft)
# htdemucs_ft is fine-tuned and slightly better; htdemucs is faster.
DEMUCS_MODEL=htdemucs

# Set to "true" to use spleeter instead of demucs (much faster on CPU, lower quality)
USE_SPLEETER=false

# TTS backend: "elevenlabs" (default) or "sarvam"
TTS_BACKEND=elevenlabs
